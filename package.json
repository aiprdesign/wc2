{
  "name": "the-inheritance",
  "private": true,
  "description": "THE INHERITANCE: a motion-graphics film celebrating the achievements of Western civilization, rendered in code.",
  "type": "module",
  "scripts": {
    "serve": "node -e \"import('./tools/serve.mjs').then(m=>m.serve(process.cwd(),8080)).then(()=>console.log('http://127.0.0.1:8080'))\"",
    "stills": "node tools/stills.mjs",
    "render": "node tools/render.mjs out/the-inheritance.mp4",
    "render:3d": "node tools/render.mjs out/the-inheritance-3d.mp4 --film film3d"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
